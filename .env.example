# Copie este arquivo para .env e substitua os valores de exemplo.
# O arquivo .env é ignorado pelo Git e não deve ser versionado.

# Chave usada pela billing-api para assinar os tokens JWT (HMAC-SHA256).
# Deve ter pelo menos 32 caracteres. Valor apenas demonstrativo:
JWT_KEY=exemplo-troque-esta-chave-por-um-valor-aleatorio-com-32-ou-mais-caracteres

# Administrador inicial, criado pela billing-api na primeira execução
# somente se ainda não existir nenhum administrador no banco.
# Defina uma senha própria antes do primeiro "docker compose up".
# Regras: nome com 3 a 150 caracteres, CPF com 11 números,
# telefone com 8 a 20 caracteres e senha com 8 a 100 caracteres.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@korp.local
BOOTSTRAP_ADMIN_CPF=00000000000
BOOTSTRAP_ADMIN_PHONE=(00) 00000-0000
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha
